# ─── Supabase ──────────────────────────────────────────────────────────────────
# Required — get from Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Required — get from Stripe dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Required for webhook signature verification — get from Stripe → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Required for subscription plan name mapping — get from Stripe → Products
STRIPE_PRICE_SEEKER_ELITE=price_...
STRIPE_PRICE_EMPLOYER_PRO=price_...
STRIPE_PRICE_EMPLOYER_VISIONARY=price_...
STRIPE_PRICE_EMPLOYER_NEXUS=price_...

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Required for transactional emails — get from resend.com
RESEND_API_KEY=re_...

# Optional — defaults shown below
EMAIL_FROM=BidJobs <noreply@bidjobs.io>
CONTACT_SUPPORT_EMAIL=support@bidjobs.io

# ─── Site ──────────────────────────────────────────────────────────────────────
# Required — your production domain (used for SEO canonicals + Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://bidjobs.io
